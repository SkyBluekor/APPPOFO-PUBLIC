{
  "name": "apppofo-portfolio-example",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": [
      "APPPOFO_API_TOKEN",
      "APPPOFO_FACE_KEY_V1"
    ]
  },
  "vars": {
    "APPPOFO_DEPLOYMENT_STAGE": "public-example",
    "APPPOFO_FACE_REMOTE_ENABLED": "disabled",
    "APPPOFO_FACE_ALLOWED_HOST": "portfolio-api.example.invalid",
    "APPPOFO_FACE_POLICY_VERSION": "production-face-storage-v1",
    "APPPOFO_FACE_SCAN_POLICY_VERSION": "production-face-scan-v1",
    "APPPOFO_FACE_MATCH_THRESHOLD": "0.65",
    "APPPOFO_FACE_MATCH_MARGIN": "0.05"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apppofo-portfolio-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
