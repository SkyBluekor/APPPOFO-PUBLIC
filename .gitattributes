# Preserve reviewed snapshot and original Unity metadata bytes across checkouts.
# SHA-256 checks intentionally include line endings; disable automatic EOL conversion.
* -text
*.png binary
*.jpg binary
*.onnx binary
*.wav binary
*.otf binary
*.ttf binary

# Exclude third-party code/assets from GitHub language breakdown.
# Keep app-written C#, Java/Android plugins, JS API, Python/PowerShell tools and app shaders counted.
"Assets/TextMesh Pro/**" linguist-vendored
Packages/com.opencvplus.unity/** linguist-vendored
